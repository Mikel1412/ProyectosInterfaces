<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pruebas.PrimaryController">
   <children>
      <Label text="Primary View" />
      <Button fx:id="botonGuardar" disable="true" onAction="#switchToSecondary" text="Switch to Secondary View" />
      <CheckBox fx:id="checkAcepto" mnemonicParsing="false" text="CheckBox" />
      <Label fx:id="display" text="Poblacion sin seleccionar" />
      <ComboBox fx:id="comboPoblacion" onAction="#mostrar" prefWidth="150.0" promptText="Poblacion" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
